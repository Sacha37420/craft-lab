# ── Adresses ─────────────────────────────────────────────────────
PORT_BACKEND=8097
BACKEND_URL=http://localhost:8097
PORT_FRONTEND=4213
FRONTEND_URL=http://localhost:4213

# ── Base de données ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devdb
DB_SCHEMA=craft_lab
DB_USER=devuser
DB_PASSWORD=CHANGE_ME

# ── Django ───────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=*

# ── Reverse proxy (Caddy) ────────────────────────────────────────
SCRIPT_NAME=/craft-lab-api

# ── SSO Keycloak ─────────────────────────────────────────────────
KEYCLOAK_CLIENT_ID=craft-lab
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/ssolab
# Client public (SPA Angular) — Keycloak → Clients → craft-lab → Access type : Public
# Valid redirect URIs : http://localhost:4213/*

# ── URLs (propagées automatiquement par reset_url.sh) ────────────
PORT_KEYCLOAK=8080
SERVER_URL_LAN=http://192.168.1.X
SERVER_URL_WAN=http://VOTRE_IP_WAN
KEYCLOAK_URL=http://192.168.1.X:8080
KEYCLOAK_PUBLIC_URL=http://VOTRE_IP_WAN:8080

# ── HTTPS / Caddy ─────────────────────────────────────────────────────────────
DOMAIN=CHANGE_ME

# ── Service relais temps réel (Lot 8) ──────────────────────────────────────
# Secret partagé entre backend et relay/ pour le callback de vérification de
# billet WebSocket (cf. api/models.py::RelayTicket) — à générer une fois avec
# `openssl rand -hex 32`, jamais laissé à CHANGE_ME en déploiement réel.
RELAY_INTERNAL_KEY=CHANGE_ME
PORT_RELAY=8098
